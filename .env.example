# ============================================
# Convex Configuration
# ============================================
# Run `npx convex dev` in packages/backend to get these values locally
# For production, set via: bunx convex env set VAR_NAME value

CONVEX_DEPLOYMENT=prod:zealous-scorpion-285

# Frontend URLs (used by both apps)
EXPO_PUBLIC_CONVEX_URL=https://zealous-scorpion-285.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://zealous-scorpion-285.convex.site

# Product preset: demo (loud teaching; Netlify default) | app (quieter returning investor)
EXPO_PUBLIC_PRODUCT_PRESET=demo
# BCH settlement network for the Fund-on-BCH flow: "chipnet" (default, test
# coins via faucet) or "mainnet" (real BCH — only after chipnet E2E passes).
# EXPO_PUBLIC_BCH_NETWORK=chipnet
# CashToken category (32-byte hex) for token-denominated pledges (e.g. PUSD).
# Unset = BCH-only pledges. The tx builder already handles token inputs,
# token outputs, and excess-token change — this just enables the spend.
# EXPO_PUBLIC_BCH_PLEDGE_TOKEN=
# When preset=app, set to 1 to hint UI that act gates need auth (server uses REQUIRE_AUTH_TO_ACT)
# EXPO_PUBLIC_REQUIRE_AUTH_TO_ACT=1

# ============================================
# Soft identity (Convex deployment env — set via `bunx convex env set`)
# ============================================
# SoftEmail magic link provider id: soft-email
# AUTH_RESEND_KEY=re_xxx
# AUTH_EMAIL_FROM=JuaKali <onboarding@resend.dev>
# Demo peek of magic links in UI (turn off when Resend is live):
# SOFT_AUTH_INBOX=1
# Optional shared secret for /soft-auth/inbox:
# SOFT_AUTH_INBOX_SECRET=
# Enforce sign-in before pledge / approve / seed / startCommitment:
# REQUIRE_AUTH_TO_ACT=1

# ============================================
# Staging environment (recommended before enabling the flags above in prod)
# ============================================
# 1. Create a second Convex deployment: `npx convex env` runs against the
#    deployment in CONVEX_DEPLOYMENT; create staging with:
#      cd packages/backend && npx convex deployment create --name staging
# 2. Point a Netlify deploy-preview branch at it via its own env vars:
#      CONVEX_DEPLOYMENT=dev:<staging-deployment>
#      EXPO_PUBLIC_CONVEX_URL=https://<staging-deployment>.convex.cloud
#      EXPO_PUBLIC_CONVEX_SITE_URL=https://<staging-deployment>.convex.site
#      EXPO_PUBLIC_PRODUCT_PRESET=demo
# 3. Seed staging with the demo seeder (Home → Seed); never seed prod.
# 4. Prod hardening (set on the prod deployment via `bunx convex env set`):
#      REQUIRE_AUTH_TO_ACT=1        # identity-to-act (already built, enforce it)
#      SOFT_AUTH_INBOX=             # unset once AUTH_RESEND_KEY is live
#      AUTH_RESEND_KEY=re_xxx       # production Resend key

# ============================================
# Google Gemini API
# ============================================
# Get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ============================================
# Agent Service
# ============================================
# Agent service URL (used by frontend agent chat)
EXPO_PUBLIC_AGENT_URL=http://localhost:8080
# Bearer token for the founder voice KPI endpoint (/voice/kpi-checkin).
# Set the same value on the Convex deployment: bunx convex env set VOICE_KPI_TOKEN ...
# EXPO_PUBLIC_VOICE_KPI_TOKEN=

# Agent service -> Convex backend URL
CONVEX_SITE_URL=https://zealous-scorpion-285.convex.site

# ============================================
# MCP Server
# ============================================
JUAKALI_BACKEND_URL=https://zealous-scorpion-285.convex.site

# ============================================
# AgentMail (agent-native inbox — live on prod)
# ============================================
# Prod inbox: juakali@agentmail.to
# Webhook: {EXPO_PUBLIC_CONVEX_SITE_URL}/webhooks/agentmail (Svix-verified)
# Set secrets on Convex only (never commit real values):
#   npx convex env set AGENTMAIL_API_KEY 'am_...' --prod
#   npx convex env set AGENTMAIL_WEBHOOK_SECRET 'whsec_...' --prod
# Inbox-scoped keys (am_us_inbox_*): bind with
#   npx convex run agentMail:setup '{"inboxId":"juakali@agentmail.to"}'
# Org keys can auto-provision: npx convex run agentMail:setup '{}'
# Docs: https://docs.agentmail.to/welcome
# AGENTMAIL_API_KEY=
# AGENTMAIL_WEBHOOK_SECRET=

# ============================================
# Africa's Talking (optional - for SMS/voice production)
# ============================================
# AFRICAS_TALKING_USERNAME=
# AFRICAS_TALKING_API_KEY=
# AFRICAS_TALKING_SENDER_ID=
# ============================================
# Native build (EAS) + RevenueCat — dormant
# (Shipaton 2026 closed without an entry; kept for a future store launch.)
# ============================================
# Inlined at EAS build time — set via EAS secrets, never commit real values.
# EXPO_PUBLIC_CONVEX_URL / EXPO_PUBLIC_AGENT_URL must point at deployed URLs for store builds.
# Store build preset (quieter returning-investor UX vs loud demo):
# EXPO_PUBLIC_PRODUCT_PRESET=app

# Public RevenueCat SDK key (Google Play / App Store). Configured at runtime:
# EXPO_PUBLIC_REVENUECAT_KEY=

# Convex deployment secret for the signed /webhooks/revenuecat endpoint
# (set via `bunx convex env set REVENUECAT_WEBHOOK_SECRET <auth-key> --prod`):
# REVENUECAT_WEBHOOK_SECRET=
