# ============================================
# Convex Configuration
# ============================================
# Run `npx convex dev` in packages/backend to get these values locally
# For production, set via: bunx convex env set VAR_NAME value

CONVEX_DEPLOYMENT=prod:zealous-scorpion-285

# Frontend URLs (used by both apps)
EXPO_PUBLIC_CONVEX_URL=https://zealous-scorpion-285.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://zealous-scorpion-285.convex.site

# Product preset: demo (loud teaching; Netlify default) | app (quieter returning investor)
EXPO_PUBLIC_PRODUCT_PRESET=demo
# When preset=app, set to 1 to hint UI that act gates need auth (server uses REQUIRE_AUTH_TO_ACT)
# EXPO_PUBLIC_REQUIRE_AUTH_TO_ACT=1

# ============================================
# Soft identity (Convex deployment env — set via `bunx convex env set`)
# ============================================
# SoftEmail magic link provider id: soft-email
# AUTH_RESEND_KEY=re_xxx
# AUTH_EMAIL_FROM=JuaKali <onboarding@resend.dev>
# Demo peek of magic links in UI (turn off when Resend is live):
# SOFT_AUTH_INBOX=1
# Optional shared secret for /soft-auth/inbox:
# SOFT_AUTH_INBOX_SECRET=
# Enforce sign-in before pledge / approve / seed / startCommitment:
# REQUIRE_AUTH_TO_ACT=1

# ============================================
# Google Gemini API
# ============================================
# Get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ============================================
# Agent Service
# ============================================
# Agent service URL (used by frontend agent chat)
EXPO_PUBLIC_AGENT_URL=http://localhost:8080

# Agent service -> Convex backend URL
CONVEX_SITE_URL=https://zealous-scorpion-285.convex.site

# ============================================
# MCP Server
# ============================================
JUAKALI_BACKEND_URL=https://zealous-scorpion-285.convex.site

# ============================================
# AgentMail (agent-native inbox — live on prod)
# ============================================
# Prod inbox: juakali@agentmail.to
# Webhook: {EXPO_PUBLIC_CONVEX_SITE_URL}/webhooks/agentmail (Svix-verified)
# Set secrets on Convex only (never commit real values):
#   npx convex env set AGENTMAIL_API_KEY 'am_...' --prod
#   npx convex env set AGENTMAIL_WEBHOOK_SECRET 'whsec_...' --prod
# Inbox-scoped keys (am_us_inbox_*): bind with
#   npx convex run agentMail:setup '{"inboxId":"juakali@agentmail.to"}'
# Org keys can auto-provision: npx convex run agentMail:setup '{}'
# Docs: https://docs.agentmail.to/welcome
# AGENTMAIL_API_KEY=
# AGENTMAIL_WEBHOOK_SECRET=

# ============================================
# Africa's Talking (optional - for SMS/voice production)
# ============================================
# AFRICAS_TALKING_USERNAME=
# AFRICAS_TALKING_API_KEY=
# AFRICAS_TALKING_SENDER_ID=
