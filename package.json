{
    "name": "bloom-monorepo-template",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "dev:backend": "turbo run dev --filter=@bloom/backend",
        "dev:mobile": "turbo run dev --filter=@bloom/mobile",
        "build": "turbo run build",
        "export:web": "npm run export:web -w @bloom/mobile",
        "deploy:backend": "npm run deploy -w @bloom/backend",
        "lint": "turbo run lint",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "verify:lock": "node scripts/verify-lock-optional-deps.mjs",
        "gitleaks": "gitleaks detect --source . --verbose",
        "prepare": "husky"
    },
    "lint-staged": {
        "apps/default/**/*.{js,jsx,ts,tsx}": [
            "eslint --max-warnings=0 -c apps/default/eslint.config.mjs"
        ],
        "packages/backend/**/*.{js,jsx,ts,tsx,mjs}": [
            "eslint --max-warnings=0 -c packages/backend/eslint.config.mjs"
        ]
    },
    "devDependencies": {
        "husky": "^9.0.0",
        "lint-staged": "^16.4.0",
        "turbo": "^2.0.12"
    }
}
